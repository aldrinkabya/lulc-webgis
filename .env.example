# ============================================================
# Backend (api.py) — FastAPI server configuration
# ============================================================

# Directory containing Cloud-Optimized GeoTIFF (COG) datasets.
# Expected files: 2019_cog.tif, 2023_cog.tif, brickfield_2019_cog.tif,
#                 brickfield_2023_cog.tif, bing_satellite_2019_cog.tif,
#                 bing_satellite_2023_cog.tif
LULC_DATA_DIR=data/cogs

# Comma-separated list of allowed CORS origins.
CORS_ORIGINS=http://localhost:3000

# ============================================================
# Frontend (Next.js) — Environment variables prefixed with
# NEXT_PUBLIC_ are exposed to the browser.
# ============================================================

# Backend API base URL used by the frontend to request tiles and statistics.
NEXT_PUBLIC_API_URL=http://localhost:8000
